---
import Layout from '@/layouts/Layout.astro'
import {template} from '@/settings'
import {getCollection, render} from 'astro:content'
import TableOfContents from '@/components/ui/TableOfContents.astro'
import Comments from '@/components/ui/Comments.astro'

export async function getStaticPaths(): Promise<Array<{ params: { slug: string }, props: { post: any } }>> {
    const blogEntries = await getCollection("blog");

    const posts = blogEntries
        .map(post => {
        const slug = post.id
            return {
            params: { slug },
            props: { post },
            }
    })
    return posts
}
const {post} = Astro.props;
const { title, date, tags} = post.data; 
const { Content, headings } = await render(post);
---

<Layout title={title} wide>
	<TableOfContents slot='sidebar' headings={headings} />
	<div class='mx-auto w-full'>
		<article
			class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80'
		>
			<!-- Header section -->
			<div class='mb-8 border-b pb-8 max-w-3xl mx-auto'>
				<h1 class='text-4xl font-bold mb-4 text-base-content'>{title}</h1>
				<div class='flex flex-wrap items-center gap-4 text-base-content/70'>
					<!-- Date -->
					<time datetime={date} class='flex items-center'>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							class='h-4 w-4 mr-2'
							fill='none'
							viewBox='0 0 24 24'
							stroke='currentColor'
						>
							<path
								stroke-linecap='round'
								stroke-linejoin='round'
								stroke-width='2'
								d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'
							></path>
						</svg>
						{
							new Date(date).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
								timeZone: 'UTC',
							})
						}
					</time>

					<!-- Tags -->
					{
						tags && (
							<div class='flex flex-wrap gap-2'>
								{tags.map(tag => (
									<span class='badge badge-accent badge-outline'>{tag}</span>
								))}
							</div>
						)
					}
				</div>
			</div>

			<!-- Post content -->
			<div
				class='prose max-w-none mt-8 prose-h2:text-3xl prose-h2:font-bold prose-h2:mb-4
         prose-h3:text-xl prose-h3:font-semibold prose-h3:mb-3
         prose-p:mb-4 prose-p:leading-relaxed
         prose-strong:text-base-content prose-strong:font-bold
         prose-em:italic
         prose-a:text-accent prose-a:no-underline hover:prose-a:underline
         prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:pl-4 prose-blockquote:italic
         prose-ul:list-disc prose-ul:pl-6
         prose-ol:list-decimal prose-ol:pl-6
         prose-li:mb-2
         prose-img:rounded-lg prose-img:my-8 post-content'
        >
                <Content />
			</div>
		</article>

		<Comments />
	</div>
</Layout>

<style is:global>
	/* Inline code only. Fenced blocks are coloured by Shiki and must not
	   inherit the inline chip styling, or every token gets its own background. */
	.post-content :not(pre) > code {
		@apply text-accent bg-base-200 px-1 py-0.5 rounded font-normal;
	}
	.post-content :not(pre) > code::before,
	.post-content :not(pre) > code::after {
		content: none;
	}
	.post-content pre {
		@apply rounded-lg p-4 overflow-x-auto my-6 text-sm leading-relaxed;
	}
	.post-content pre code {
		@apply bg-transparent p-0 text-inherit;
	}
	/* Figures are external SVGs whose ink is baked dark, because currentColor
	   cannot inherit the page theme through an <img>. Give them a light card so
	   they stay legible in dark mode. */
	.post-content img[src$='.svg'] {
		@apply bg-white rounded-lg p-4 w-full h-auto;
	}
	.post-content figure {
		@apply my-8;
	}
	/* Long lines are hard to read, so hold body text to a comfortable measure
	   while figures, code and tables use the full column. */
	/* Figures and code get the wider measure; running text is held tighter so a
	   line stays around 80 characters at 20px. Both share a centre axis. */
	.post-content > * {
		@apply max-w-4xl mx-auto;
	}
	.post-content > p,
	.post-content > ul,
	.post-content > ol,
	.post-content > blockquote,
	.post-content > h2,
	.post-content > h3 {
		@apply max-w-3xl;
	}
	.post-content > p:has(img) {
		@apply max-w-4xl;
	}

	/* Medium-style reading typography: serif body at 20px on a 1.6 rhythm.
	   Headings stay in the sans stack for contrast. */
	.post-content {
		font-family: Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia,
			'Times New Roman', serif;
		font-size: 20px;
		line-height: 1.6;
	}
	.post-content h2,
	.post-content h3,
	.post-content h4 {
		font-family: inherit;
	}
	.post-content > h2 {
		@apply mt-12;
	}
	.post-content em {
		@apply text-base-content/70;
	}
	.post-content pre,
	.post-content code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8em;
	}
	.post-content figcaption,
	.post-content > p > em:only-child {
		font-size: 0.85em;
	}
	/* A markdown image sits inside its own paragraph, so that paragraph must be
	   released from the text measure or the figure inherits it. */

	.post-content figcaption {
		@apply text-sm text-base-content/60 mt-3 text-center;
	}
	.post-content svg {
		@apply mx-auto block;
	}
</style>
